{
  "model_name": "fase2_opt_adam",
  "dataset": {
    "csv_path": "data and documentation/digits.csv",
    "feature_col": "image",
    "target_col": "label",
    "num_classes": 10,
    "extra_csv_paths": []
  },
  "split": {
    "k_folds": 5,
    "stratify": true,
    "val_fraction_if_k1": 0.2,
    "random_seed": 42
  },
  "preprocessing": {
    "normalization": "none",
    "one_hot_targets": true
  },
  "architecture": {
    "layer_sizes": [
      784,
      100,
      50,
      10
    ],
    "activations": [
      "relu",
      "relu",
      "softmax"
    ],
    "initializer": "auto"
  },
  "training": {
    "loss": "cross_entropy",
    "optimizer": {
      "name": "adam",
      "lr": 0.001
    },
    "epochs": 50,
    "batch_size": 16,
    "early_stopping_patience": 10
  },
  "regularization": {
    "l2": 0.0,
    "dropout": 0.0,
    "lr_schedule": null,
    "augmentation": null
  }
}
