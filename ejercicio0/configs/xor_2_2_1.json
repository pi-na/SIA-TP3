{
  "model_name": "xor_2_2_1",
  "dataset": {
    "csv_path": "ejercicio0/xor_dataset.csv",
    "feature_col": ["x1", "x2"],
    "target_col": "y",
    "num_classes": 2,
    "extra_csv_paths": []
  },
  "split": {
    "k_folds": 1,
    "stratify": false,
    "val_fraction_if_k1": 0.0,
    "random_seed": 7
  },
  "preprocessing": {
    "normalization": "none",
    "one_hot_targets": false
  },
  "architecture": {
    "layer_sizes": [2, 2, 1],
    "activations": ["tanh", "tanh"],
    "initializer": "auto"
  },
  "training": {
    "loss": "mse",
    "optimizer": {"name": "adam", "lr": 0.05},
    "epochs": 2000,
    "batch_size": 4,
    "early_stopping_patience": null
  },
  "regularization": {
    "l2": 0.0,
    "dropout": 0.0,
    "lr_schedule": null,
    "augmentation": null
  }
}
